{
  "info": {
    "name": "Distributed Job Processor",
    "description": "API collection for the Distributed Job Processor. Set the `baseUrl` and `apiKey` variables before running.\n\nBase URL: http://localhost:3000\nAPI Key: value of API_KEY in your .env file",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "change-me-in-production",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "No API key → 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"payload\": { \"to\": \"user@example.com\" }\n}"
            }
          }
        },
        {
          "name": "Wrong API key → 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "wrong-key" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"payload\": { \"to\": \"user@example.com\" }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create email job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"payload\": {\n    \"to\": \"user@example.com\",\n    \"subject\": \"Hello from Job Processor\"\n  },\n  \"maxAttempts\": 3\n}"
            }
          }
        },
        {
          "name": "Create report job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"report\",\n  \"payload\": {\n    \"report_type\": \"monthly\"\n  },\n  \"maxAttempts\": 3\n}"
            }
          }
        },
        {
          "name": "Create data-processing job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"data-processing\",\n  \"payload\": {\n    \"source\": \"s3://bucket/file.csv\"\n  },\n  \"maxAttempts\": 3\n}"
            }
          }
        },
        {
          "name": "Get job by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", ":id"],
              "variable": [{ "key": "id", "value": "replace-with-job-id" }]
            }
          }
        },
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Invalid job type → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"unknown-type\",\n  \"payload\": {}\n}"
            }
          }
        },
        {
          "name": "Email missing 'to' field → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"payload\": {\n    \"subject\": \"No recipient\"\n  }\n}"
            }
          }
        },
        {
          "name": "Report missing 'report_type' field → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"report\",\n  \"payload\": {}\n}"
            }
          }
        }
      ]
    }
  ]
}
