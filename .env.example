# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobprocessor

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# API
PORT=3000
API_KEY=

# Query Service
GRPC_PORT=50051

# Worker
WORKER_CONCURRENCY=5
JOB_TIMEOUT_SECONDS=30
METRICS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Observability — OTel traces sent to Tempo (set automatically by docker-compose)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=api   # or worker
